# Copie para .env e ajuste. Não coloque segredos neste arquivo.

# Banco vetorial
QDRANT_URL=http://localhost:6333

# LLM local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b

# Modelo de embeddings em uso: e5 (intfloat/multilingual-e5-base) ou qwen3 (qwen3-embedding:4b)
MODELO_EMBEDDINGS=e5

# Abaixo deste score, a resposta diz que não encontrou (RN11). Calibrado na fase 9.
LIMIAR_SIMILARIDADE=0.80

# Receitas com scores a esta distância contam como empatadas e são desempatadas pelos ingredientes que faltam
TOLERANCIA_EMPATE=0.01

# Ingredientes sempre disponíveis (lista provisória, ponto em aberto do modelo de domínio)
INGREDIENTES_BASICOS=["sal","agua","oleo"]
