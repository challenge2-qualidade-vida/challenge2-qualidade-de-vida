# Copie para .env e ajuste. Não coloque segredos neste arquivo.

# Banco vetorial
QDRANT_URL=http://localhost:6333

# LLM local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b
# Janela de contexto do LLM, em tokens (o padrão do Ollama, 4096, corta os trechos)
OLLAMA_CONTEXTO=8192
# Segundos de espera pela resposta do LLM (na CPU, uma resposta com cinco receitas passa de 10 min)
OLLAMA_TEMPO_LIMITE=1800

# Modelo de embeddings em uso: e5 (intfloat/multilingual-e5-base) ou qwen3 (qwen3-embedding:4b)
MODELO_EMBEDDINGS=e5

# Onde o e5 roda: auto (mps no Mac, cuda com GPU NVIDIA, senão cpu), cpu, mps ou cuda
DISPOSITIVO_EMBEDDINGS=auto

# Abaixo deste score, a resposta diz que não encontrou (RN11). Um limiar por modelo, porque os
# scores têm escalas diferentes; vale o do MODELO_EMBEDDINGS (ou do --modelo da CLI).
# Recalibre com o `comparar` (coluna "limiar") quando a base ou o conjunto de perguntas mudar.
LIMIAR_SIMILARIDADE_E5=0.845
LIMIAR_SIMILARIDADE_QWEN3=0.620

# Receitas com scores a esta distância contam como empatadas e são desempatadas pelos ingredientes que faltam
TOLERANCIA_EMPATE=0.01

# Ingredientes sempre disponíveis (lista provisória, ponto em aberto do modelo de domínio)
INGREDIENTES_BASICOS=["sal","agua","oleo","salt","water","oil"]

# Redação da resposta do Miau-ricio. A avaliação (docs/semana-2/avaliacao-rag.md) compara as opções:
# resposta_com_fontes_v1 (texto livre) ou resposta_com_fontes_v2 (JSON com os trechos usados)
PROMPT_DE_RESPOSTA=resposta_com_fontes_v1
RESPOSTA_ESTRUTURADA=false
# pede ao LLM que reescreva citando quando a resposta vem sem citação
SEGUNDA_TENTATIVA_DE_CITACAO=false
