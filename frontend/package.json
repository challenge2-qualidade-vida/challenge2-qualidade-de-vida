{
  "name": "economia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:falso": "VITE_DADOS_FALSOS=1 VITE_FUNCIONALIDADES=todas vite",
    "build": "npm run tipos-api && tsc -b && vite build",
    "preview": "vite preview",
    "tipos-api": "openapi-typescript openapi/provisorio.yaml -o src/api/esquema.d.ts",
    "verificar": "tsc -b --noEmit",
    "teste": "vitest run",
    "teste:visual": "playwright test"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
